{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "vite.config.ts"
    ],
  "exclude": [
    "node_modules",
    "examples",
    "skills",
    "mini-services",
    "tool-results",
    "download",
    "upload",
    "tests",
    "db"
  ]
}
