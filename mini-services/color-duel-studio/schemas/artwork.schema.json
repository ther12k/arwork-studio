{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color Duel Detailed Artwork v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "format",
    "id",
    "version",
    "title",
    "viewBox",
    "regionCount",
    "paletteCount",
    "assets",
    "contentHash",
    "objectGroups",
    "rendering",
    "qa"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "format": {
      "const": "color-duel-detailed-vector-1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "viewBox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "regionCount": {
      "type": "integer",
      "minimum": 1
    },
    "paletteCount": {
      "type": "integer",
      "minimum": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assets": {
      "type": "object",
      "required": [
        "regions",
        "palette",
        "paint",
        "coloredSvg",
        "numberedSvg",
        "thumbnail"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+\\.(json|svg|webp|png)$"
      }
    },
    "objectGroups": {
      "type": "array"
    },
    "rendering": {
      "type": "object"
    },
    "qa": {
      "type": "object"
    }
  }
}