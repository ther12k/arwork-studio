{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color Duel Detailed Vector Regions (schema 2: curved masters + visible-region geometry)",
  "type": "object",
  "required": [
    "schemaVersion",
    "artworkId",
    "artworkVersion",
    "viewBox",
    "fillRule",
    "regions",
    "decorations",
    "detailPaths"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2],
      "description": "1 = legacy polygon geometry; 2 = curved masters (M/L/C/Q/Z) authoritative + visible-region geometry (masks do not overlap)."
    },
    "geometrySchema": {
      "enum": [1, 2],
      "description": "Explicit mirror of schemaVersion used by the studio toolchain."
    },
    "visibleRegionGeometry": {
      "type": "boolean",
      "description": "True when regions are visible surfaces: opaque coverage subtracted, so any fill order colors correctly."
    },
    "artworkId": {
      "type": "string"
    },
    "artworkVersion": {
      "type": "string"
    },
    "viewBox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "fillRule": {
      "enum": ["evenodd", "nonzero"],
      "description": "Default rule for this geometry; individual regions may override (source fill rules are preserved)."
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "decorations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "detailPaths": {
      "type": "array"
    },
    "edges": {
      "type": "array",
      "description": "Boundary contract (stage 2, optional; absent/empty = legacy stroke rendering). artwork = true master boundary, subdivision = artificial gameplay boundary.",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "boundaryStyle": {
        "$ref": "#/$defs/boundaryStyle"
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "required": ["id", "d", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "d": {
          "type": "string",
          "pattern": "^M[\\s\\d.,eE+\\-MLQCZ]+$",
          "description": "Open or closed M/L/C/Q/Z path data (master units)."
        },
        "kind": {
          "enum": ["artwork", "subdivision"]
        },
        "leftRegion": {
          "type": ["string", "null"],
          "description": "Region bordering one side of the segment (null at canvas edge or where no region borders it)."
        },
        "rightRegion": {
          "type": ["string", "null"],
          "description": "Region bordering the other side (null at canvas edge or where no region borders it)."
        }
      }
    },
    "boundaryStyle": {
      "type": "object",
      "description": "Per-kind stroke overrides for the edges overlay; missing kinds use the documented defaults.",
      "properties": {
        "artwork": {
          "$ref": "#/$defs/boundaryStroke"
        },
        "subdivision": {
          "$ref": "#/$defs/boundaryStroke"
        }
      }
    },
    "boundaryStroke": {
      "type": "object",
      "required": ["stroke", "strokeWidth"],
      "properties": {
        "stroke": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "strokeWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dash": {
          "type": "string",
          "maxLength": 40,
          "description": "SVG stroke-dasharray value (user space), e.g. '3 2.2'."
        }
      }
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "paletteId",
        "objectId",
        "d",
        "fillRule",
        "bbox",
        "area",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "paletteId": {
          "type": "integer",
          "minimum": 1
        },
        "objectId": {
          "type": "string"
        },
        "d": {
          "type": "string",
          "pattern": "^M[\\s\\d.,eE+\\-MLQCZ]+Z$",
          "description": "Authoritative curved path data (M/L/C/Q/Z, absolute, closed)."
        },
        "fillRule": {
          "enum": ["evenodd", "nonzero"],
          "description": "Per-region fill rule preserved from the source SVG (schema 2)."
        },
        "masterShapeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Link to the sanitized master shape this region was derived from (authoring; optional at runtime)."
        },
        "rings": {
          "type": "array",
          "description": "Derived flattened approximation (authoring only; not the master geometry).",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "area": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "object",
          "required": [
            "x",
            "y",
            "fontSize",
            "minScreenPx",
            "clearance"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "fontSize": {
              "type": "number",
              "minimum": 0
            },
            "minScreenPx": {
              "type": "number"
            },
            "clearance": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
