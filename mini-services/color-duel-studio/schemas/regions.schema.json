{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color Duel Detailed Vector Regions v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "artworkId",
    "artworkVersion",
    "viewBox",
    "fillRule",
    "regions",
    "decorations",
    "detailPaths"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artworkId": {
      "type": "string"
    },
    "artworkVersion": {
      "type": "string"
    },
    "viewBox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "fillRule": {
      "const": "evenodd"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "paletteId",
          "objectId",
          "d",
          "fillRule",
          "rings",
          "bbox",
          "area",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "paletteId": {
            "type": "integer",
            "minimum": 1
          },
          "objectId": {
            "type": "string"
          },
          "d": {
            "type": "string",
            "pattern": "^M[\\s\\d.,eE+\\-MLZ]+Z$"
          },
          "fillRule": {
            "const": "evenodd"
          },
          "rings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "area": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "label": {
            "type": "object",
            "required": [
              "x",
              "y",
              "fontSize",
              "minScreenPx",
              "clearance"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "fontSize": {
                "type": "number",
                "minimum": 0
              },
              "minScreenPx": {
                "type": "number"
              },
              "clearance": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "decorations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "paletteId",
          "objectId",
          "d",
          "fillRule",
          "rings",
          "bbox",
          "area",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "paletteId": {
            "type": "integer",
            "minimum": 1
          },
          "objectId": {
            "type": "string"
          },
          "d": {
            "type": "string",
            "pattern": "^M[\\s\\d.,eE+\\-MLZ]+Z$"
          },
          "fillRule": {
            "const": "evenodd"
          },
          "rings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "area": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "label": {
            "type": "object",
            "required": [
              "x",
              "y",
              "fontSize",
              "minScreenPx",
              "clearance"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "fontSize": {
                "type": "number",
                "minimum": 0
              },
              "minScreenPx": {
                "type": "number"
              },
              "clearance": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "detailPaths": {
      "type": "array"
    }
  }
}