# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# vite / production
/dist/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# color-duel-studio backend: never commit runtime state, caches or release output
__pycache__/
mini-services/color-duel-studio/workspace/
mini-services/color-duel-studio/dist/

# secrets, databases, tool output and downloaded artifacts — never commit
.env
db/
tool-results/
download/
*.pyc

# exception: the env template is documentation and is tracked
!mini-services/color-duel-studio/.env.example
